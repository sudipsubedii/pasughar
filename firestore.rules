rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function retailerPath(uid) { return /databases/$(database)/documents/retailers/$(uid); }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function hasRetailerRole() {
      return signedIn() && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == 'retailer';
    }
    function hasVerifiedContact() {
      return signedIn() && (
        request.auth.token.email_verified == true
        || (request.auth.token.phone_number is string && request.auth.token.phone_number.size() > 0)
      );
    }
    function isVerifiedRetailer() {
      return hasRetailerRole() && hasVerifiedContact()
        && exists(retailerPath(request.auth.uid))
        && get(retailerPath(request.auth.uid)).data.status == 'approved';
    }
    function validImageUrl(value) {
      return value is string && value.size() <= 2048 && value.matches('https://.*');
    }
    function validVideos(videos) {
      return videos is list && videos.size() <= 3
        && (videos.size() < 1 || validImageUrl(videos[0]))
        && (videos.size() < 2 || validImageUrl(videos[1]))
        && (videos.size() < 3 || validImageUrl(videos[2]));
    }
    function validImages(images) {
      return images is list && images.size() >= 1 && images.size() <= 5
        && validImageUrl(images[0])
        && (images.size() < 2 || validImageUrl(images[1]))
        && (images.size() < 3 || validImageUrl(images[2]))
        && (images.size() < 4 || validImageUrl(images[3]))
        && (images.size() < 5 || validImageUrl(images[4]));
    }
    function validProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.description is string && data.description.size() > 0 && data.description.size() <= 2500
        && data.price is number && data.price > 0 && data.price <= 100000000
        && data.stock is number && data.stock >= 0 && data.stock <= 1000000
        && data.category is string && data.category.size() <= 80
        && data.unit is string && data.unit.size() <= 30
        && data.location is string && data.location.size() <= 220
        && validImageUrl(data.image) && validImages(data.images)
        && data.attributes is map
        && (!('videoUrls' in data) || validVideos(data.videoUrls));
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['displayName','email','phone','createdAt','role'])
        && request.resource.data.role in ['customer','retailer'];
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','phone','photoURL','updatedAt']);
      allow delete: if isAdmin();
    }

    // Retailer documents are keyed by Firebase Auth UID in production.
    // A new seller may create only their own pending application. Only admin code may verify/suspend them.
    match /retailers/{retailerId} {
      allow read: if isOwner(retailerId) || isAdmin();
      allow create: if isOwner(retailerId) && hasRetailerRole()
        && request.resource.data.keys().hasOnly(['ownerId','storeName','contactName','email','phone','location','description','status','createdAt','updatedAt','openingHours','publicPhone','publicEmail','website','vetSpecialties','vetAvailability','consultationFee','verificationDocs','isVet'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.storeName is string && request.resource.data.storeName.size() > 0
        && request.resource.data.contactName is string && request.resource.data.contactName.size() > 0
        && request.resource.data.email is string && request.resource.data.email.size() > 0
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0
        && request.resource.data.location is string && request.resource.data.location.size() > 0;
      allow update: if isAdmin() || (isOwner(retailerId) && hasRetailerRole()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description','phone','location','updatedAt','openingHours','publicPhone','publicEmail','website','vetSpecialties','vetAvailability','consultationFee','verificationDocs','isVet']));
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      // Public catalogue query filters on status == 'approved'. Firestore Rules are not
      // filters, so keep the public read condition query-provable. Only verified retailers
      // can create/update published listings; trusted admin moderation also changes listing
      // status when a shop is suspended/banned.
      allow read: if isAdmin()
        || (signedIn() && resource.data.retailerId == request.auth.uid)
        || resource.data.status == 'approved';
      allow create: if isVerifiedRetailer()
        && request.resource.data.retailerId == request.auth.uid
        && request.resource.data.status == 'approved'
        && validProduct(request.resource.data)
        && request.resource.data.keys().hasOnly(['name','category','condition','description','price','unit','stock','location','image','images','videoUrls','attributes','retailer','retailerId','status','createdAt','updatedAt']);
      allow update: if isAdmin() || (isVerifiedRetailer()
        && resource.data.retailerId == request.auth.uid
        && request.resource.data.retailerId == resource.data.retailerId
        && (request.resource.data.status == resource.data.status || request.resource.data.status in ['approved','paused'])
        && resource.data.status in ['approved','paused']
        && validProduct(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','category','condition','description','price','unit','stock','location','image','images','attributes','videoUrls','retailer','status','updatedAt']));
      allow delete: if isAdmin() || (isVerifiedRetailer() && resource.data.retailerId == request.auth.uid);
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create, update, delete: if false; // Use createOrder callable; supports guest checkout.
    }
    match /retailerOrders/{retailerOrderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.retailerId == request.auth.uid);
      allow create, delete: if false;
      allow update: if (isAdmin() || (signedIn() && resource.data.retailerId == request.auth.uid))
        && request.resource.data.retailerId == resource.data.retailerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','statusUpdatedBy','updatedAt'])
        && request.resource.data.statusUpdatedBy == request.auth.uid
        && request.resource.data.status in ['Confirmed','Rejected','Processing','Shipped','Delivered','Cancelled']
        && (isAdmin()
          || (resource.data.status == 'Pending' && request.resource.data.status in ['Confirmed','Rejected','Cancelled'])
          || (resource.data.status == 'Confirmed' && request.resource.data.status in ['Processing','Cancelled'])
          || (resource.data.status == 'Processing' && request.resource.data.status in ['Shipped','Cancelled'])
          || (resource.data.status == 'Shipped' && request.resource.data.status == 'Delivered'));
    }

    // Reports are written/moderated only through trusted Cloud Functions.
    // Their content is private to admins, which avoids exposing reporter contact details.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /reportDedupe/{key} { allow read, write: if false; }
    match /reportRateLimits/{key} { allow read, write: if false; }
    // Checkout idempotency records are server-only. The Admin SDK bypasses these client rules.
    match /orderRequests/{requestId} { allow read, write: if false; }

    // Breeding date requests: customer creates; customer, assigned retailer, and admin can read.
    match /breedingBookings/{bookingId} {
      allow create: if hasVerifiedContact()
        && request.resource.data.keys().hasOnly(['productId','productName','retailerId','customerUid','customerName','customerEmail','customerPhone','location','requestedDate','note','status','createdAt','updatedAt'])
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.retailerId is string
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() > 0
        && request.resource.data.customerPhone.size() <= 40
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0
        && request.resource.data.location.size() <= 180
        && request.resource.data.requestedDate is string
        && request.resource.data.requestedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000
        && request.resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/products/$(request.resource.data.productId))
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.status == 'approved'
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.category == 'pets-supplies'
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.attributes.petSection == 'breeding'
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.retailerId == request.resource.data.retailerId;
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerUid == request.auth.uid)
        || (signedIn() && resource.data.retailerId == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn() && resource.data.retailerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          && request.resource.data.status in ['accepted','declined','completed','cancelled']);
      allow delete: if isAdmin();
    }


    match /enquiries/{enquiryId} {
      allow create: if hasVerifiedContact()
        && request.resource.data.keys().hasOnly(['productId','productName','retailerId','customerUid','customerName','customerEmail','customerPhone','message','reply','status','createdAt','updatedAt'])
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.retailerId is string
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 1500
        && request.resource.data.status == 'open'
        && request.resource.data.reply == ''
        && exists(/databases/$(database)/documents/products/$(request.resource.data.productId))
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.status == 'approved'
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.retailerId == request.resource.data.retailerId;
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerUid == request.auth.uid)
        || (signedIn() && resource.data.retailerId == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn() && resource.data.retailerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply','status','messages','updatedAt'])
          && request.resource.data.reply is string
          && request.resource.data.reply.size() <= 1500
          && request.resource.data.status in ['open','replied']
          && request.resource.data.messages is list
          && request.resource.data.messages.size() == resource.data.get('messages', []).size() + 1
          && request.resource.data.messages[request.resource.data.messages.size() - 1] is map
          && request.resource.data.messages[request.resource.data.messages.size() - 1].keys().hasOnly(['senderUid','senderRole','body','createdAt'])
          && request.resource.data.messages[request.resource.data.messages.size() - 1].senderUid == request.auth.uid
          && request.resource.data.messages[request.resource.data.messages.size() - 1].body is string
          && request.resource.data.messages[request.resource.data.messages.size() - 1].body.size() >= 2
          && request.resource.data.messages[request.resource.data.messages.size() - 1].body.size() <= 1500
          && ((resource.data.customerUid == request.auth.uid
                && request.resource.data.messages[request.resource.data.messages.size() - 1].senderRole == 'customer'
                && request.resource.data.reply == resource.data.reply
                && request.resource.data.status == 'open')
              || (resource.data.retailerId == request.auth.uid
                && request.resource.data.messages[request.resource.data.messages.size() - 1].senderRole == 'retailer'
                && request.resource.data.reply == request.resource.data.messages[request.resource.data.messages.size() - 1].body
                && request.resource.data.status == 'replied')));
      allow delete: if isAdmin();
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, delete: if false;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','readAt'])
        && request.resource.data.read == true;
    }

    match /vetAppointments/{appointmentId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerUid == request.auth.uid)
        || (signedIn() && resource.data.storeId == request.auth.uid);
      allow create, update, delete: if false; // Book, cancel, and reschedule only through trusted callable functions.
    }
    match /vetSlotLocks/{lockId} {
      allow read, write: if false;
    }

    match /publicStores/{storeId} {
      allow read: if true;
      allow create, update: if isOwner(storeId) && hasRetailerRole()
        && exists(retailerPath(storeId))
        && get(retailerPath(storeId)).data.status == 'approved'
        && request.resource.data.keys().hasOnly(['storeId','storeName','description','location','publicPhone','publicEmail','website','openingHours','vetSpecialties','vetAvailability','vetAppointmentSlots','consultationFee','isVet','updatedAt'])
        && request.resource.data.storeId == request.auth.uid;
      allow delete: if isAdmin() || isOwner(storeId);
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'published' || isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if hasVerifiedContact()
        && request.resource.data.keys().hasOnly(['productId','orderId','customerId','customerName','rating','body','status','createdAt'])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.orderId is string
        && reviewId == request.resource.data.orderId + '_' + request.resource.data.productId
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 80
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 10
        && request.resource.data.body.size() <= 1500
        && request.resource.data.status == 'published'
        && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.productIds is list
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.productIds.hasAny([request.resource.data.productId])
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.deliveredProductIds is list
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.deliveredProductIds.hasAny([request.resource.data.productId])
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if isAdmin();
    }
    match /wishlists/{userId} { allow read, write: if isOwner(userId); }
    match /platformSettings/{settingId} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /auditLogs/{logId} { allow read: if isAdmin(); allow write: if false; }
  }
}
